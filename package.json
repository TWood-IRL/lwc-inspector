{
    "name": "lwc-inspector",
    "description": "My amazing LWC app",
    "version": "0.0.1",
    "author": "Thomas Woodhouse",
    "bugs": "https://github.com/londoner1234/lwc-inspector/issues",
    "dependencies": {
        "@analytics/google-tag-manager": "^0.6.0",
        "analytics": "^0.8.19",
        "axios": "^1.13.0",
        "compression": "^1.8.0",
        "cookie-session": "^2.1.1",
        "dotenv": "^17.0.0",
        "express": "^5.1.0",
        "file-saver": "^2.0.5",
        "helmet": "^8.1.0",
        "highlight.js": "^11.12.0",
        "jsforce": "^3.10.0",
        "jszip": "^3.10.1",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@lwc/engine-dom": "^9.5.1",
        "@lwc/eslint-plugin-lwc": "^3.5.0",
        "@lwc/jest-preset": "^19.6.1",
        "@lwc/rollup-plugin": "^9.5.1",
        "@lwc/synthetic-shadow": "^9.5.1",
        "@lwc/wire-service": "^9.5.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@salesforce-ux/design-system": "^2.264.1",
        "@salesforce/eslint-config-lwc": "^4.1.2",
        "eslint": "^9.39.5",
        "eslint-plugin-inclusive-language": "^2.2.1",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "lightning-base-components": "^1.28.19-alpha",
        "lint-staged": "^17.6.0",
        "lwc": "^9.5.1",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.9.10",
        "rollup": "^4.64.7"
    },
    "engines": {
        "node": ">=20"
    },
    "homepage": "https://github.com/londoner1234/lwc-inspector",
    "keywords": [
        "lwc"
    ],
    "license": "MIT",
    "lint-staged": {
        "**/*.{css,html,js,json,md,yaml,yml}": [
            "prettier --write"
        ],
        "src/**/*.js": [
            "eslint"
        ]
    },
    "repository": "londoner1234/lwc-inspector",
    "scripts": {
        "build": "rollup -c --environment NODE_ENV:production",
        "build:development": "rollup -c",
        "lint": "eslint src scripts",
        "prettier": "prettier --write \"**/*.{css,html,js,json,md,yaml,yml}\"",
        "prettier:verify": "prettier --list-different \"**/*.{css,html,js,json,md,yaml,yml}\"",
        "serve": "node src/server/api.js",
        "serve:api": "node src/server/api.js",
        "serve:client": "node scripts/server.js",
        "test:unit": "jest",
        "test:unit:coverage": "jest --coverage",
        "test:unit:debug": "node --inspect-brk node_modules/jest/bin/jest.js --runInBand",
        "test:unit:watch": "jest --watch",
        "watch": "run-p watch:client watch:server",
        "watch:client": "rollup -c -w",
        "watch:server": "node --watch-path=src/server src/server/api.js",
        "prepare": "husky"
    }
}

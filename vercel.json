{
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        { "source": "/api/:path*", "destination": "/api" },
        { "source": "/oauth2/:path*", "destination": "/api" },
        { "source": "/auth/:path*", "destination": "/api" }
    ]
}

# Copy to .env and fill in real values. Never commit .env.

# Connected App credentials (Salesforce Setup > App Manager)
SALESFORCE_CLIENT_ID=your-connected-app-consumer-key
SALESFORCE_CLIENT_SECRET=your-connected-app-consumer-secret

# Must match the callback URL on the Connected App
SALESFORCE_CALLBACK_URL=http://localhost:3002/auth/callback

LOGIN_URL_PROD=https://login.salesforce.com
LOGIN_URL_SANDBOX=https://test.salesforce.com

# Long random string used to sign the session cookie
NODE_SESSION_SECRET_KEY=change-me-to-a-long-random-string
